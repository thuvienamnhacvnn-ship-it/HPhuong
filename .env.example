# HPHUONG Cosmetic & Spa — environment (copy to .env.local). No secrets in this file.

# Public base URL (links in e-mails)
APP_URL=http://localhost:3035

# Required in production: random 32+ chars. Encrypts guest links / voucher codes in job payloads.
APP_SECRET=

# Database: leave empty for local PGlite (data/pgdata). Production: PostgreSQL.
DATABASE_URL=
# PGLITE_DATA_DIR=data/pgdata

# Behind your own reverse proxy (nginx) → trust X-Forwarded-For for rate limits
TRUST_PROXY=0

# Background worker inside the web process (0 = run `npm run worker` separately)
INPROCESS_WORKER=1

# --- AI assistant (Claude API). Empty = rule-based chooser labelled "ohne KI".
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5
ASSISTANT_EFFORT=low

# --- E-mail (Resend). Empty = demo outbox in admin → Nachrichten, nothing is sent.
RESEND_API_KEY=
MAIL_FROM="HPHUONG Cosmetic & Spa <termine@your-domain.de>"

# --- WhatsApp Cloud API (official). Also switch on in Admin → Einstellungen.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Owner alert by SMS (seven.io): SMS_API_KEY set → SMS to OWNER_SMS_PHONE (default: OWNER_WHATSAPP_PHONE).
SMS_API_KEY=
SMS_FROM=HPHUONG

# --- Owner alert: WhatsApp message to the owner for every new booking (digits, with country code, e.g. 4915112345678).
# Free route: CallMeBot — owner sends "I allow callmebot to send me messages" to +34 644 51 95 23 once, gets an API key.
OWNER_WHATSAPP_PHONE=
CALLMEBOT_APIKEY=
# Or official Cloud API: approved template with 3 body params (name, service, time).
# WHATSAPP_TEMPLATE_OWNER_NEW=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=de
WHATSAPP_TEMPLATE_CONFIRMED=
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_RESCHEDULED=
WHATSAPP_TEMPLATE_CANCELLED=

# --- Payments. Demo runs in sandbox mode (business_settings.payment_mode = sandbox).
# Webhook HMAC secret per provider (derived from APP_SECRET when empty).
PAYMENT_WEBHOOK_SECRET=

# --- Seed (first start only). Empty = random passwords written to data/demo-credentials.txt
SEED_OWNER_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_THERAPIST_PASSWORD=
